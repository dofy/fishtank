{
  "name": "fishtank",
  "version": "1.4.10",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "A browser idle aquarium game inspired by PC FISH: breed, collect and merge fish across swappable Realistic Reef and Monochrome LCD themes.",
  "homepage": "https://fishtank.phpz.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/dofy/fishtank.git"
  },
  "bugs": {
    "url": "https://github.com/dofy/fishtank/issues"
  },
  "keywords": [
    "aquarium",
    "idle-game",
    "pixel-art",
    "lcd",
    "virtual-pet",
    "breeding-game",
    "canvas-game",
    "typescript"
  ],
  "author": {
    "name": "Seven Yu",
    "email": "dofyyu@gmail.com",
    "url": "https://yahaha.net"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && env -u CLOUDFLARE_API_TOKEN wrangler deploy"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
